# Razorpay Live Credentials
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id_here

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Redis Configuration (Optional for caching)
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

#SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key
SUPABASE_SERVICE_ROLE_KEY=service_role_key

# MSG91 OTP Widget (Login with OTP)
NEXT_PUBLIC_MSG91_WIDGET_ID=your_widget_id
# Account authkey — server only (verifyAccessToken). On Vercel, disable Authkey IP security
# in MSG91 (error 418 = IP not whitelisted; Vercel IPs are dynamic).
MSG91_AUTH_KEY=your_msg91_authkey
# Optional: OTP Widget token (Tokens sidebar)
MSG91_WIDGET_TOKEN=your_msg91_widget_token
NEXT_PUBLIC_MSG91_AUTH_TOKEN=your_msg91_widget_token
# Keep true on Vercel so login still works when verifyAccessToken returns 418
MSG91_ALLOW_JWT_FALLBACK=true
